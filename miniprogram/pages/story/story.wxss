/* pages/story/story.wxss */

.story-header {
  text-align: center;
}

.story-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.story-hint {
  font-size: 24rpx;
  color: var(--color-muted);
}

/* Story body */
.story-body {}

.collect-bar {
  margin-bottom: 20rpx;
}

.collect-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.story-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--color-text);
}

/* Vocabulary chest items */
.vocab-chest {}

.vocab-item {
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e0d0ff;
}

.vocab-item--locked {
  background: #faf5ff;
  opacity: 0.75;
}

.vocab-item--collected {
  background: #fefce8;
  border-color: #fbbf24;
}

.vocab-item-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.vocab-lock {
  font-size: 32rpx;
  flex-shrink: 0;
}

.vocab-word-block {
  flex: 1;
}

.vocab-word {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.vocab-stems {
  display: block;
  font-size: 22rpx;
  color: var(--color-primary-mid);
  font-style: italic;
  margin-top: 4rpx;
}

.vocab-detail {
  padding-top: 8rpx;
}

.vocab-construction {
  display: block;
  font-size: 24rpx;
  color: #7c3aed;
  background: #ede9fe;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.vocab-definition,
.vocab-example {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
  color: var(--color-text);
}

.vocab-label {
  font-weight: 700;
  color: var(--color-primary);
}

.vocab-hint {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
  font-style: italic;
}

/* Completion banner */
.completion-banner {
  text-align: center;
  background: linear-gradient(135deg, #fef9f0, #fff7ed);
  border: 2rpx solid #fbbf24;
}

.completion-emoji {
  display: block;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.completion-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.completion-sub {
  display: block;
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 24rpx;
}

.completion-btn {
  margin: 0;
}

/* Back button */
.btn-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 28rpx 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: #f5f0ff;
  border: 2rpx solid #c0a8ff;
  margin-bottom: 32rpx;
}

/* Bottom sheet backdrop */
.sheet-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

/* Bottom sheet */
.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx 60rpx;
  z-index: 101;
  box-shadow: 0 -8rpx 40rpx rgba(74, 16, 128, 0.18);
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #e0d0ff;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-word-block {
  flex: 1;
}

.sheet-word {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.sheet-stems {
  display: block;
  font-size: 24rpx;
  color: var(--color-primary-mid);
  font-style: italic;
  margin-top: 6rpx;
}

.sheet-close {
  font-size: 40rpx;
  color: var(--color-muted);
  padding: 0 8rpx;
  line-height: 1;
}

.sheet-construction {
  display: block;
  font-size: 26rpx;
  color: #7c3aed;
  background: #ede9fe;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.sheet-row {
  margin-bottom: 16rpx;
}

.sheet-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.sheet-value {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text);
}
